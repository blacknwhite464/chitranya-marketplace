rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "28jNe77DmcY7fgGrKhKNgwubDCa2";
    }

    function belongsToSignedInCustomer(data) {
      return request.auth != null
        && 'userId' in data
        && data.userId == request.auth.uid;
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pricingRules/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /quoteServices/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /quotations/{quotationId} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasAll([
          'quoteId','customerName','phone','email','notes','items',
          'itemCount','subtotal','discountTotal','total','status','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'quoteId','customerName','phone','email','notes','items',
          'itemCount','subtotal','discountTotal','total','status','createdAt','userId'
        ])
        && (!('userId' in request.resource.data)
          || (request.auth != null && request.resource.data.userId == request.auth.uid))
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.itemCount is number
        && request.resource.data.itemCount > 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.discountTotal is number
        && request.resource.data.discountTotal >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt == request.time);
      allow read: if isAdmin() || belongsToSignedInCustomer(resource.data);
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'orderId','customerName','phone','address','city','notes',
          'paymentMethod','items','itemCount','total','status','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderId','customerName','phone','address','city','notes',
          'paymentMethod','items','itemCount','total','status','createdAt','userId'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.address is string
        && request.resource.data.city is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.status == 'Pending'
        && request.resource.data.paymentMethod == 'Cash on Delivery'
        && request.resource.data.createdAt == request.time
        && (!('userId' in request.resource.data)
          || (request.auth != null && request.resource.data.userId == request.auth.uid));

      allow read: if isAdmin() || belongsToSignedInCustomer(resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /serviceBookings/{bookingId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'customerName','phone','email','service','address','city',
          'preferredDate','preferredTime','details','status','source','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'customerName','phone','email','service','address','city',
          'preferredDate','preferredTime','details','status','source','createdAt','userId'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() > 0
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 300
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 100
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.preferredTime is string
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 1500
        && request.resource.data.status == 'Pending'
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time
        && (!('userId' in request.resource.data)
          || (request.auth != null && request.resource.data.userId == request.auth.uid));

      allow read: if isAdmin() || belongsToSignedInCustomer(resource.data);
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}